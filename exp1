<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JavaScript Demonstration | Lab Experiment</title>

    <style>
        /* ================= THEME VARIABLES ================= */
        /* Default Light Theme variables */
        :root, body[data-theme="light"] {
          --bg-color: #f8fafc;
          --card-bg: #ffffff;
          --text-main: #333333;
          --text-muted: #64748b;
          --primary: #007bff;
          --primary-hover: #0056b3;
          --border: #e2e8f0;
          --info-bg: #f1f5f9;
          --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        }
        
        /* Dark Theme variables */
        body[data-theme="dark"] {
          --bg-color: #0f172a;
          --card-bg: #1e293b;
          --text-main: #f5f5f5;
          --text-muted: #94a3b8;
          --primary: #bb86fc;
          --primary-hover: #9d4edd;
          --border: #334155;
          --info-bg: #0f172a;
          --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.5);
        }
        
        /* Pink Theme variables */
        body[data-theme="pink"] {
          --bg-color: #fff0f5;
          --card-bg: #ffffff;
          --text-main: #4a0e2e;
          --text-muted: #8b5a74;
          --primary: #ff69b4;
          --primary-hover: #ff1493;
          --border: #ffd1dc;
          --info-bg: #ffe4e1;
          --shadow: 0 4px 6px -1px rgb(255 105 180 / 0.1);
        }
        
        /* Green Theme variables */
        body[data-theme="green"] {
          --bg-color: #e8f5e9;
          --card-bg: #ffffff;
          --text-main: #1b5e20;
          --text-muted: #4e7d53;
          --primary: #4caf50;
          --primary-hover: #388e3c;
          --border: #c8e6c9;
          --info-bg: #d0f0c0;
          --shadow: 0 4px 6px -1px rgb(76 175 80 / 0.1);
        }

        /* ================= LAYOUT STYLES ================= */
        body {
          background-color: var(--bg-color);
          color: var(--text-main);
          transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
          font-family: sans-serif;
          padding: 20px;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          min-height: 90vh;
        }

        .theme-selector {
          margin-bottom: 20px;
          background: var(--card-bg);
          padding: 10px 20px;
          border-radius: 8px;
          box-shadow: var(--shadow);
          border: 1px solid var(--border);
        }

        .theme-selector select {
          padding: 5px 10px;
          border-radius: 4px;
          border: 1px solid var(--border);
          background: var(--card-bg);
          color: var(--text-main);
          cursor: pointer;
        }

        .dashboard {
            background: var(--card-bg);
            padding: 40px;
            border-radius: 16px;
            width: 100%;
            max-width: 650px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            transition: background 0.3s, border 0.3s;
        }

        header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid var(--border);
            padding-bottom: 20px;
        }

        h1 {
            color: var(--primary);
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .welcome-box {
            font-size: 16px;
            color: var(--text-muted);
            font-style: italic;
            min-height: 24px;
        }

        .section-title {
            font-size: 18px;
            color: var(--text-main);
            margin-bottom: 15px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            background: var(--info-bg);
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 30px;
            transition: background 0.3s;
        }

        .info-item span {
            display: block;
            font-size: 12px;
            text-transform: uppercase;
            color: var(--text-muted);
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .info-item p {
            font-size: 16px;
            font-weight: 600;
            color: var(--text-main);
        }

        .demo-area {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 35px;
        }

        .btn-card {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 20px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgb(0 0 0 / 0.05);
        }

        .btn-desc {
            text-align: left;
        }

        .btn-desc h4 {
            font-size: 15px;
            color: var(--text-main);
        }

        .btn-desc p {
            font-size: 12px;
            color: var(--text-muted);
        }

        button {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 10px 18px;
            font-size: 14px;
            font-weight: 500;
            border-radius: 6px;
            cursor: pointer;
            transition: background-color 0.2s;
            white-space: nowrap;
        }

        button:hover {
            background-color: var(--primary-hover);
        }

        footer {
            text-align: center;
            border-top: 1px solid var(--border);
            padding-top: 20px;
            font-size: 13px;
            color: var(--text-muted);
        }

        footer strong {
            color: var(--text-main);
        }
    </style>

    <!-- Internal JavaScript -->
    <script>
        function changeTheme(themeName) {
            document.body.setAttribute('data-theme', themeName);
            localStorage.setItem('selectedTheme', themeName);
        }

        function showWelcome() {
            // Load saved theme automatically on startup
            const savedTheme = localStorage.getItem('selectedTheme');
            if (savedTheme) {
                document.getElementById('theme-select').value = savedTheme;
                changeTheme(savedTheme);
            }

            // Target the welcome container safely
            const welcomeElement = document.getElementById("welcome");
            if (welcomeElement) {
                welcomeElement.innerHTML = "Welcome to the JavaScript Demonstration Webpage!";
            }

            // Demonstrate diverse Console Methods
            console.log("Welcome message dynamically injected via Internal JS.");
            console.info("Internal JavaScript block executed successfully on body load.");
            console.warn("Console demonstration initialization completed.");
        }
    </script>
</head>
<body onload="showWelcome()">

    <!-- Theme Selector Dropdown Box -->
    <div class="theme-selector">
      <label for="theme-select">Choose Theme: </label>
      <select id="theme-select" onchange="changeTheme(this.value)">
        <option value="light">Light</option>
        <option value="dark">Dark</option>
        <option value="pink">Pink</option>
        <option value="green">Green</option>
      </select>
    </div>

    <!-- Dashboard Container -->
    <div class="dashboard">
        <header>
            <h1>JS Execution Environments</h1>
            <p id="welcome" class="welcome-box"></p>
        </header>

        <main>
            <h3 class="section-title">User Metadata</h3>
            <div class="info-grid">
                <div class="info-item">
                    <span>Developer Name</span>
                    <p>Bhumika Arora</p>
                </div>
                <div class="info-item">
                    <span>Permanent Reg. No (PRN)</span>
                    <p>24070521227</p>
                </div>
            </div>

            <h3 class="section-title">Execution Controls</h3>
            <div class="demo-area">
                <!-- Inline JavaScript Block -->
                <div class="btn-card">
                    <div class="btn-desc">
                        <h4>Inline Execution</h4>
                        <p>Triggers script directly inside the HTML tag attributes.</p>
                    </div>
                    <button onclick="console.log('Inline button clicked.'); alert('Hello Arya Khandekar! This is Inline JavaScript.');">
                        Run Inline
                    </button>
                </div>

                <!-- External JavaScript Block -->
                <div class="btn-card">
                    <div class="btn-desc">
                        <h4>External Execution</h4>
                        <p>Calls decoupled functions stored inside an detached script file.</p>
                    </div>
                    <button onclick="showExternalMessage()">
                        Run External
                    </button>
                </div>
            </div>
        </main>

        <footer>
            <p>Webpage engineered for academic evaluation by <strong>Arya Khandekar</strong> (PRN: 24070521227)</p>
        </footer>
    </div>
</body>
</html>
