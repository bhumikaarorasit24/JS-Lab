<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Billing Calculator Experiment</title>
    <style>
        /* ================= THEME VARIABLES ================= */
        /* Default Light Theme variables */
        :root, body[data-theme="light"] {
          --bg-color: #f8fafc;
          --text-main: #333333;
          --receipt-color: #000000;
          --receipt-bg: #ffffff;
          --receipt-border: #cccccc;
          --footer-text: #555555;
          --border-color: #ccc;
          --select-bg: #ffffff;
        }
        
        /* Dark Theme variables */
        body[data-theme="dark"] {
          --bg-color: #0f172a;
          --text-main: #f5f5f5;
          --receipt-color: #38bdf8;
          --receipt-bg: #1e293b;
          --receipt-border: #334155;
          --footer-text: #94a3b8;
          --border-color: #334155;
          --select-bg: #1e293b;
        }
        
        /* Pink Theme variables */
        body[data-theme="pink"] {
          --bg-color: #fff0f5;
          --text-main: #4a0e2e;
          --receipt-color: #ff1493;
          --receipt-bg: #ffffff;
          --receipt-border: #ffd1dc;
          --footer-text: #8b5a74;
          --border-color: #ffd1dc;
          --select-bg: #ffffff;
        }
        
        /* Green Theme variables */
        body[data-theme="green"] {
          --bg-color: #e8f5e9;
          --text-main: #1b5e20;
          --receipt-color: #2e7d32;
          --receipt-bg: #ffffff;
          --receipt-border: #c8e6c9;
          --footer-text: #4e7d53;
          --border-color: #c8e6c9;
          --select-bg: #ffffff;
        }

        /* ================= APPLICATION STYLES ================= */
        body {
            font-family: Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 20px;
            padding: 20px;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .theme-selector {
          margin-bottom: 20px;
          padding: 10px 0;
        }

        .theme-selector select {
          padding: 6px 12px;
          border-radius: 4px;
          border: 1px solid var(--border-color);
          background-color: var(--select-bg);
          color: var(--text-main);
          cursor: pointer;
        }

        pre {
            white-space: pre-wrap;
            font-family: 'Courier New', Courier, monospace;
            margin-top: 20px;
            color: var(--receipt-color);
            background-color: var(--receipt-bg);
            border: 1px solid var(--receipt-border);
            padding: 15px;
            border-radius: 8px;
            max-width: 450px;
            transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
        }

        .developer-footer {
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px dashed var(--border-color);
            font-size: 14px;
            color: var(--footer-text);
            line-height: 1.4;
            transition: color 0.3s ease, border-color 0.3s ease;
        }
    </style>
</head>
<body>

    <!-- Theme Selector Dropdown Box -->
    <div class="theme-selector">
      <label for="theme-select">Choose Theme: </label>
      <select id="theme-select" onchange="changeTheme(this.value)">
        <option value="light">Light</option>
        <option value="dark">Dark</option>
        <option value="pink">Pink</option>
        <option value="green">Green</option>
      </select>
    </div>

    <h2>Billing Calculator</h2>
    <p>Your receipt has been generated below:</p>
    
    <pre id="receiptDisplay"></pre>

    <div class="developer-footer">
        <strong>Developed By:</strong><br>
        Name: Bhumika Arora<br>
        PRN: 24070521227
    </div>

    <script>
        // Theme Switcher Functions
        function changeTheme(themeName) {
            document.body.setAttribute('data-theme', themeName);
            localStorage.setItem('selectedThemeBilling', themeName);
        }

        // Initialize Theme Persistence
        const savedTheme = localStorage.getItem('selectedThemeBilling');
        if (savedTheme) {
            document.getElementById('theme-select').value = savedTheme;
            changeTheme(savedTheme);
        }

        // Billing Logic Prompts
        var customerName = prompt("Enter customer name:"); 
        var productName = prompt("Enter product name:");
        let costPerProduct = parseFloat(prompt("Enter cost per product (₹):").replace(/,/g, ''));
        let quantity = parseInt(prompt("Enter quantity:").replace(/,/g, ''));

        const GST_RATE = 0.18; 

        let totalBeforeTax = costPerProduct * quantity;
        let gstAmount = totalBeforeTax * GST_RATE;
        let finalBill = totalBeforeTax + gstAmount;

        const receiptObject = {
            custName: customerName,
            prodName: productName,
            qty: quantity,
            baseCost: totalBeforeTax,
            tax: gstAmount,
            totalPayable: finalBill
        };

        const { custName, prodName, qty, baseCost, tax, totalPayable } = receiptObject;

        const billingReceipt = `
========================================
             QUICKBILL MART
========================================
Developer Name  : BHUMIKA ARORA
PRN             : 24070521227
----------------------------------------
Customer Name   : ${custName}
Product Name    : ${prodName}
Quantity        : ${qty}
Cost per Unit   : ₹${costPerProduct.toFixed(2)}
----------------------------------------
Total (Base)    : ₹${baseCost.toFixed(2)}
GST (18%)       : ₹${tax.toFixed(2)}
----------------------------------------
FINAL BILL      : ₹${totalPayable.toFixed(2)}
========================================
`;

        document.getElementById("receiptDisplay").innerText = billingReceipt;
        console.log(billingReceipt);
    </script>

</body>
</html>
