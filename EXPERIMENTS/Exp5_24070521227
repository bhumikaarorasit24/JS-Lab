<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart Calculator</title>
    <style>
        /* ================= THEME VARIABLES ================= */
        /* Default Light Theme variables */
        :root, body[data-theme="light"] {
          --bg-color: #ffffff;
          --text-main: #000000;
          --text-muted: #555555;
          --input-bg: #ffffff;
          --input-border: #cccccc;
          --btn-bg: #e1e1e1;
          --btn-text: #000000;
          --btn-border: #bbbbbb;
          --btn-hover: #d5d5d5;
          --total-highlight: #000000;
          --hr-color: #cccccc;
        }
        
        /* Dark Theme variables */
        body[data-theme="dark"] {
          --bg-color: #0f172a;
          --text-main: #f8fafc;
          --text-muted: #94a3b8;
          --input-bg: #1e293b;
          --input-border: #475569;
          --btn-bg: #38bdf8;
          --btn-text: #0f172a;
          --btn-border: #38bdf8;
          --btn-hover: #7dd3fc;
          --total-highlight: #38bdf8;
          --hr-color: #334155;
        }
        
        /* Pink Theme variables */
        body[data-theme="pink"] {
          --bg-color: #fff0f5;
          --text-main: #4a0e2e;
          --text-muted: #8b5a74;
          --input-bg: #ffffff;
          --input-border: #ffd1dc;
          --btn-bg: #ff69b4;
          --btn-text: #ffffff;
          --btn-border: #ff69b4;
          --btn-hover: #ff1493;
          --total-highlight: #ff1493;
          --hr-color: #ffd1dc;
        }
        
        /* Green Theme variables */
        body[data-theme="green"] {
          --bg-color: #e8f5e9;
          --text-main: #1b5e20;
          --text-muted: #4e7d53;
          --input-bg: #ffffff;
          --input-border: #c8e6c9;
          --btn-bg: #4caf50;
          --btn-text: #ffffff;
          --btn-border: #4caf50;
          --btn-hover: #388e3c;
          --total-highlight: #2e7d32;
          --hr-color: #c8e6c9;
        }

        /* ================= APPLICATION STYLES ================= */
        body {
            font-family: Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 40px;
            line-height: 1.6;
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        .theme-selector {
            margin-bottom: 25px;
        }
        .theme-selector select {
            padding: 6px 12px;
            border-radius: 4px;
            border: 1px solid var(--input-border);
            background-color: var(--input-bg);
            color: var(--text-main);
            cursor: pointer;
            font-size: 0.9em;
            transition: background-color 0.3s, border-color 0.3s, color 0.3s;
        }
        hr {
            border: 0;
            border-top: 1px solid var(--hr-color);
            transition: border-color 0.3s ease;
        }
        input {
            padding: 5px;
            font-size: 1em;
            width: 250px;
            background-color: var(--input-bg);
            color: var(--text-main);
            border: 1px solid var(--input-border);
            border-radius: 4px;
            box-sizing: border-box;
            transition: background-color 0.3s, border-color 0.3s, color 0.3s;
        }
        button {
            padding: 6px 15px;
            font-size: 1em;
            cursor: pointer;
            background-color: var(--btn-bg);
            color: var(--btn-text);
            border: 1px solid var(--btn-border);
            border-radius: 4px;
            font-weight: bold;
            transition: background-color 0.2s, color 0.2s, border-color 0.2s;
        }
        button:hover {
            background-color: var(--btn-hover);
        }
        h3 {
            color: var(--total-highlight);
            transition: color 0.3s ease;
        }
    </style>
</head>
<body>

    <!-- Theme Selector Dropdown Box -->
    <div class="theme-selector">
        <label for="theme-select">Choose Theme: </label>
        <select id="theme-select" onchange="changeTheme(this.value)">
            <option value="light">Light Theme</option>
            <option value="dark">Dark Theme</option>
            <option value="pink">Pink Theme</option>
            <option value="green">Green Theme</option>
        </select>
    </div>

    <!-- Student Details Section -->
    <div>
        <p><b>Name:</b> Bhumika Arora</p>
        <p><b>PRN:</b> 24070521227</p>
    </div>
    <hr>

    <h2>Simple Shopping Cart</h2>

    <!-- Input Form (One below the other using <br> tags) -->
    <div>
        <label>Item Name:</label><br>
        <input type="text" id="itemName" placeholder="Enter item name"><br><br>

        <label>Quantity:</label><br>
        <input type="number" id="itemQty" placeholder="Enter quantity"><br><br>

        <label>Price (₹):</label><br>
        <input type="number" id="itemPrice" placeholder="Enter price"><br><br>

        <button onclick="addItem()">Add to Cart</button>
    </div>

    <!-- Display area for items -->
    <h4>Cart Items:</h4>
    <ul id="itemList"></ul>

    <!-- Display area for calculated totals -->
    <div>
        <p>Subtotal: ₹<span id="subtotal">0</span></p>
        <p id="discountMsg" style="color: orange; font-weight: bold;"></p>
        <h3>Final Total: ₹<span id="finalTotal">0</span></h3>
    </div>

<script>
    // Theme Switcher Logic Layer
    function changeTheme(themeName) {
        document.body.setAttribute('data-theme', themeName);
        localStorage.setItem('selectedThemeShoppingCart', themeName);
    }

    // Persist and restore existing configuration profiles
    const savedTheme = localStorage.getItem('selectedThemeShoppingCart');
    if (savedTheme) {
        document.getElementById('theme-select').value = savedTheme;
        changeTheme(savedTheme);
    }

    // ARRAY: Create an empty array list to hold item objects
    const cart = [];

    // Function to handle adding items from inputs into our array
    function addItem() {
        const nameInput = document.getElementById("itemName").value;
        const qtyInput = Number(document.getElementById("itemQty").value);
        const priceInput = Number(document.getElementById("itemPrice").value);

        // Simple validation check to ensure inputs are not blank
        if (nameInput === "" || priceInput <= 0 || qtyInput <= 0) {
            alert("Please enter valid item details.");
            return;
        }

        // OBJECTS: Bundle input values into a single item object
        const itemObj = { 
            name: nameInput, 
            quantity: qtyInput,
            price: priceInput 
        };

        // Push the new item object into our cart array
        cart.push(itemObj);

        // Reset the input fields so they are ready for the next entry
        document.getElementById("itemName").value = "";
        document.getElementById("itemQty").value = "";
        document.getElementById("itemPrice").value = "";

        // Run calculations now that the data has changed
        updateCartDisplay();
    }

    // Function to calculate totals using array methods and display them
    function updateCartDisplay() {
        const itemList = document.getElementById("itemList");
        itemList.innerHTML = ""; // Clear out previous list text

        // ARRAY METHOD: forEach() loops through cart array to build a text list
        cart.forEach(item => {
            const itemTotal = item.price * item.quantity;
            itemList.innerHTML += `<li>${item.name} - ${item.quantity} x ₹${item.price} = ₹${itemTotal}</li>`;
        });

        // ARRAY METHOD: reduce() loops through array to sum up costs into subtotal variable
        const subtotal = cart.reduce((accumulator, item) => {
            return accumulator + (item.price * item.quantity);
        }, 0);

        // DISCOUNT LOGIC: Calculate a 10% discount if the subtotal passes ₹2000
        let discount = 0;
        const msg = document.getElementById("discountMsg");

        if (subtotal > 2000) {
            discount = subtotal * 0.10; // 10% calculation
            msg.innerText = "10% Discount Applied!";
            msg.style.color = "green";
        } else {
            msg.innerText = "No discount (Add items worth over ₹2000 for 10% off).";
            msg.style.color = "orange";
        }

        const finalTotal = subtotal - discount;

        // Print calculated data back onto screen tags
        document.getElementById("subtotal").innerText = subtotal;
        document.getElementById("finalTotal").innerText = finalTotal;
    }
</script>

</body>
</html>
